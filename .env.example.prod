# =============================================================================
# Canvas — Production Environment Variables (TASK-76)
# =============================================================================
#
#   1. cp .env.example.prod .env
#   2. Fill in every REQUIRED value below.
#   3. Optional values can stay commented for v0.4 defaults; uncomment
#      and edit them only when the related feature lands (see SMTP and
#      Observability stubs at the bottom).
#
# This file targets the production docker-compose.prod.yml stack
# (Postgres + MinIO + app, fronted by an existing nginx-proxy +
# acme-companion). For local development, copy .env.example instead.
# =============================================================================


# -----------------------------------------------------------------------------
# Public hostname  (REQUIRED — drives nginx-proxy and TLS)
# -----------------------------------------------------------------------------
# The domain that users hit. nginx-proxy generates the upstream block
# from this; acme-companion requests a Let's Encrypt cert for it.
# DNS for this hostname must already point at the VPS.
CANVAS_HOSTNAME=canvas.example.com

# Contact email for Let's Encrypt registration. ACME requires this so
# the issuer can notify you about expiration / abuse / policy changes.
LETSENCRYPT_EMAIL=ops@example.com

# The public-facing base URL — used for OG image links, share URLs,
# Better Auth callback validation. Must be the HTTPS variant of
# CANVAS_HOSTNAME once acme-companion has issued the cert.
PUBLIC_APP_URL=https://canvas.example.com


# -----------------------------------------------------------------------------
# Database (Postgres)  (REQUIRED)
# -----------------------------------------------------------------------------
# Master password for the in-stack Postgres container. Generate with:
#   openssl rand -hex 32
# NOTE: use hex (not base64). The compose file weaves this value
# directly into DATABASE_URL=postgresql://user:PASSWORD@db:5432/db
# — base64 output can contain `/` and `+` which break URL parsing
# without escaping. Hex is URL-safe by construction.
# (Codex round 1 P1.)
POSTGRES_PASSWORD=change-me

# Optional overrides for the docker-internal Postgres DB and user.
# Defaults below match the docker-compose.prod.yml fall-back.
# POSTGRES_DB=canvas
# POSTGRES_USER=canvas

# NOTE: DATABASE_URL is NOT set here. docker-compose.prod.yml
# derives it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# and the docker-internal hostname `db`. Setting it in .env would be
# overridden by compose anyway.


# -----------------------------------------------------------------------------
# Authentication (Better Auth)  (REQUIRED)
# -----------------------------------------------------------------------------
# Signs session cookies + tokens. Rotating this logs every user out;
# treat it like a database password. Generate with:
#   openssl rand -hex 32
# (Better Auth doesn't URL-encode this — base64's `/` works here,
# but using hex everywhere keeps the generation hint consistent
# with POSTGRES_PASSWORD above.)
BETTER_AUTH_SECRET=change-me-to-32-bytes-of-randomness

# BETTER_AUTH_URL is pinned to PUBLIC_APP_URL by the compose file's
# `environment:` block, so you only have to maintain one
# public-URL value. Don't set it here — the compose override wins
# regardless.


# -----------------------------------------------------------------------------
# Object storage (MinIO / S3)  (REQUIRED)
# -----------------------------------------------------------------------------
# Credentials for the in-stack MinIO container. Used by BOTH the
# minio-init bucket-bootstrap and the app's S3 client. Generate with:
#   openssl rand -hex 16   # 32-char access key
#   openssl rand -hex 32   # 64-char secret key
# (AWS SDK signs these values via HMAC — base64 would also work,
# but matching the hex convention used elsewhere avoids any
# URL-encoding surprises if these ever land in a connection-string-
# shaped config.)
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key

# Optional overrides for bucket / region. Defaults below match the
# compose file's fallbacks.
# S3_BUCKET=canvas
# S3_REGION=us-east-1

# Public CDN base URL — leave UNSET unless you front MinIO with a
# public host or CDN. When unset, the app serves asset bytes via
# `/api/assets/{key}` on its own origin (same-origin, no CORS work
# needed, keeps storage creds off the wire). See the
# `S3_PUBLIC_URL` comment in .env.example for the full discussion.
# S3_PUBLIC_URL=https://cdn.example.com


# -----------------------------------------------------------------------------
# Render cache  (OPTIONAL — defaults fine for most operators)
# -----------------------------------------------------------------------------
# CACHE_DIR is overridden by the compose file to `/data/cache/render`
# so it points at the `render_cache` named volume. Override only if
# you mount a different volume.
#
# CACHE_MAX_MB caps total render-cache disk use; LRU evicts oldest
# beyond this. Bump if you have spare disk and want a higher hit
# rate on long-tail share URLs.
# CACHE_MAX_MB=500


# -----------------------------------------------------------------------------
# Email / SMTP  (FUTURE — TASK-78 will use these)
# -----------------------------------------------------------------------------
# Required once password reset + email verification land. Until then
# the app boots fine without them; signup falls back to the no-email
# path. Uncomment and fill when TASK-78 ships.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=canvas-mailer
# SMTP_PASSWORD=
# SMTP_FROM="Canvas <no-reply@example.com>"


# -----------------------------------------------------------------------------
# Observability  (FUTURE — TASK-73 will use these)
# -----------------------------------------------------------------------------
# Sentry DSN + log level. The app currently uses console.log/error
# (visible via `docker compose logs app`). TASK-73 will wire
# structured logging + error reporting to Sentry; until then these
# are no-ops.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# LOG_LEVEL=info
