# Base URL of your Canvas instance — required.
# Example uses `https://canvas.example.com` if unset; OG images won't
# actually render until this points at a real instance with an
# `og-card` canvas defined.
CANVAS_BASE_URL=https://canvas.example.com

# Optional. Not used by `client.image()` (the URL builder doesn't
# need auth), but set if you extend the example to call
# `client.bake()` / `list()` / etc.
# CANVAS_API_KEY=sk_test_xxx
