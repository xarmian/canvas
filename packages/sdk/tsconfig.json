{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom"],
		// Under moduleResolution: bundler TS doesn't auto-discover
		// @types/node. Listed explicitly so the test files
		// (import-hygiene.test.ts uses node:fs) typecheck. The
		// PUBLISHED source intentionally avoids any node-only imports
		// — guarded both by tsup's platform: 'neutral' build setting
		// and the hygiene test itself.
		"types": ["node"],
		"declaration": true,
		"outDir": "dist",
		// rootDir covers both src/ and test/ so the edge smoke can
		// live outside src/ without tripping tsc's "all source files
		// must be under rootDir" check. tsup builds from `src/index.ts`
		// explicitly so test files never enter the published bundle
		// regardless of rootDir.
		"rootDir": ".",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
