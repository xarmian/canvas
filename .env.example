# =============================================================================
# Canvas — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL.
# Default matches the docker-compose.yml dev services.
DATABASE_URL="postgresql://canvas:canvas@localhost:5432/canvas"

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Secret key for signing sessions/tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-secret"

# The public URL of your Canvas instance (used for OAuth callbacks, etc.)
BETTER_AUTH_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Asset Storage (S3-compatible)
# -----------------------------------------------------------------------------
# S3-compatible endpoint. Default matches MinIO from docker-compose.yml.
# If port 9000 is in use, change MINIO_PORT in docker-compose and update this.
S3_ENDPOINT="http://localhost:9002"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="canvas"
S3_REGION="us-east-1"

# Public base URL for direct asset serving (OPTIONAL — opt-in).
#
# When unset (default), the app serves asset bytes through
# `/api/assets/{key}` on the SvelteKit server, which proxies from
# S3/MinIO server-side. Same-origin URLs work from any host the dev
# server is reachable on (LAN, remote preview, Cloud Code), require no
# CORS configuration on the bucket, and keep storage credentials /
# hostnames out of the browser.
#
# Set this ONLY for production deployments where you want to bypass
# the app proxy (e.g. point at a CloudFront / Cloudflare distribution
# in front of S3, or a publicly-reachable MinIO host). The value must
# be the externally-reachable BASE URL — keys are appended as
# `${S3_PUBLIC_URL}/${key}`. Example:
#   S3_PUBLIC_URL="https://cdn.example.com"
# S3_PUBLIC_URL=""

# Set to "true" to use local filesystem storage instead of S3.
# Useful for development without Docker. Files are stored in .local-storage/
STORAGE_LOCAL="false"

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
# The public-facing URL of your Canvas instance (used for OG image URLs, etc.)
PUBLIC_APP_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Render Cache
# -----------------------------------------------------------------------------
# Filesystem-backed render cache (TASK-53). Survives restart; trivial to
# swap for Redis later by reimplementing FsRenderCache's get/set.
# CACHE_DIR: where to store cached render bytes (default ./.cache/render).
# CACHE_MAX_MB: total disk cap; LRU evicts oldest-accessed beyond this.
CACHE_DIR="./.cache/render"
CACHE_MAX_MB="500"

# -----------------------------------------------------------------------------
# Programmatic Render API (v0.5+) — POST /api/v1/renders
# -----------------------------------------------------------------------------
# Per-user quota of baked-render rows. Returns 429 quota_exceeded above
# this. Each render persists in S3 / local storage indefinitely unless
# the row carries an `expiresAt`; raise this with care, and pair with
# the `renders:sweep` cron (see README "Render storage management").
RENDER_QUOTA_PER_USER="1000"

# Per-API-key rate limit: steady-state req/min for POST /api/v1/renders
# (the CPU-expensive path) and the burst-capacity cap. GET / DELETE
# endpoints get 5× both values, so they're not gated by a hot write
# bucket. Defaults: 60 req/min steady, 120 burst.
RENDER_API_RATE_LIMIT_PER_MIN="60"
RENDER_API_RATE_LIMIT_BURST="120"

# -----------------------------------------------------------------------------
# Admin pages (/admin/*)
# -----------------------------------------------------------------------------
# Comma-separated email allowlist for instance-admin pages
# (/admin/storage and any future /admin/* surface). Match is
# case-insensitive. Empty (the default) = admin routes 403 for every
# user including the only one — pragmatic safety for fresh installs
# until the operator decides who needs the surface.
# CANVAS_ADMIN_EMAILS="admin@example.com,ops@example.com"
CANVAS_ADMIN_EMAILS=""
